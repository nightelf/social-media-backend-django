# For running this service STANDALONE (outside Docker).
# In Docker, compose injects these from social-media-deploy/env/backend-django.env instead.
DATABASE_URL=postgres://social:social_dev_password@localhost:5432/social_django
DJANGO_SECRET_KEY=change-me-django-dev-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
JWT_SECRET_KEY=change-me-django-jwt-dev-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
CODE_TTL_MINUTES=10
ENV=dev
NOTIFIER=console
CORS_ALLOWED_ORIGINS=http://localhost:3000
